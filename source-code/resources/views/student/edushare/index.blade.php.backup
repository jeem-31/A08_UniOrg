<style>
.tab-content {
    animation: fadeIn 0.4s ease-in-out;
}

@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.tab-button {
    color: #6B7280;
    background-color: transparent;
    transition: color 0.2s ease;
}

.tab-button:hover:not(.active) {
    color: #374151;
}

.tab-button.active {
    color: white;
}

.upload-type-btn.active {
    border-color: #8B5CF6;
    background-color: #F3E8FF;
}

#tab-indicator {
    pointer-events: none;
}
</style>

<script>
const currentFolderId = {{ $currentFolder ? $currentFolder->id : 'null' }};
const urlParams = new URLSearchParams(window.location.search);
// If there's a folder, default to 'my' tab, otherwise use URL param or 'all'
let currentTab = currentFolderId ? (urlParams.get('tab') || 'my') : (urlParams.get('tab') || 'all');

// Initialize tab on page load
document.addEventListener('DOMContentLoaded', function() {
    // Set indicator position immediately without animation
    const indicator = document.getElementById('tab-indicator');
    indicator.style.transition = 'none';
    indicator.style.opacity = '0';
    
    // Position the indicator
    updateTabIndicator(currentTab);
    
    // Show the indicator and re-enable transition
    requestAnimationFrame(() => {
        indicator.style.opacity = '1';
        indicator.style.transition = 'all 0.3s ease-out';
    });
    
    // Show the correct tab content
    switchTabContent(currentTab);
});

function updateTabIndicator(tab) {
    const indicator = document.getElementById('tab-indicator');
    const activeTab = document.getElementById('tab-' + tab);
    const nav = activeTab.parentElement;
    
    // Get position and size
    const navRect = nav.getBoundingClientRect();
    const tabRect = activeTab.getBoundingClientRect();
    
    // Calculate position relative to nav
    const left = tabRect.left - navRect.left;
    const width = tabRect.width;
    
    // Update indicator
    indicator.style.width = width + 'px';
    indicator.style.transform = `translateX(${left}px)`;
}

function switchTabContent(tab) {
    // Hide all tabs
    document.querySelectorAll('.tab-content').forEach(el => {
        el.style.display = 'none';
        el.classList.add('hidden');
    });
    document.querySelectorAll('.tab-button').forEach(el => {
        el.classList.remove('active');
    });
    
    // Show selected tab
    const selectedContent = document.getElementById('content-' + tab);
    selectedContent.style.display = 'block';
    selectedContent.classList.remove('hidden');
    document.getElementById('tab-' + tab).classList.add('active');
}

function switchTab(tab) {
    // Switch content
    switchTabContent(tab);
    
    // Animate indicator
    updateTabIndicator(tab);
    
    currentTab = tab;
    
    // Update URL without reload
    const url = new URL(window.location);
    url.searchParams.set('tab', tab);
    window.history.pushState({}, '', url);
}

// Update indicator on window resize
window.addEventListener('resize', function() {
    updateTabIndicator(currentTab);
});

function showModal(type) {
    document.getElementById(type + 'Modal').classList.remove('hidden');
}

function hideModal(type) {
    document.getElementById(type + 'Modal').classList.add('hidden');
}

function selectUploadType(type) {
    document.querySelectorAll('.upload-type-btn').forEach(btn => {
        btn.classList.remove('active', 'border-purple-500', 'bg-purple-50');
        btn.classList.add('border-gray-200');
    });
    
    if (type === 'file') {
        document.getElementById('btn-file').classList.add('active', 'border-purple-500', 'bg-purple-50');
        document.getElementById('fileForm').classList.remove('hidden');
        document.getElementById('folderForm').classList.add('hidden');
    } else {
        document.getElementById('btn-folder').classList.add('active', 'border-purple-500', 'bg-purple-50');
        document.getElementById('folderForm').classList.remove('hidden');
        document.getElementById('fileForm').classList.add('hidden');
    }
}

function showToast(message, type = 'success') {
    const toast = document.getElementById('toast');
    const icon = document.getElementById('toastIcon');
    const title = document.getElementById('toastTitle');
    const msg = document.getElementById('toastMessage');
    
    title.textContent = type === 'success' ? 'Success!' : 'Error!';
    msg.textContent = message;
    
    toast.classList.remove('hidden', 'border-green-500', 'border-red-500');
    icon.classList.remove('bg-green-100', 'bg-red-100');
    icon.querySelector('i').classList.remove('ph-check-circle', 'ph-warning-circle', 'text-green-600', 'text-red-600');
    
    if (type === 'success') {
        toast.classList.add('border-green-500');
        icon.classList.add('bg-green-100');
        icon.querySelector('i').classList.add('ph-check-circle', 'text-green-600');
    } else {
        toast.classList.add('border-red-500');
        icon.classList.add('bg-red-100');
        icon.querySelector('i').classList.add('ph-warning-circle', 'text-red-600');
    }
    
    setTimeout(() => hideToast(), 4000);
}

function hideToast() {
    document.getElementById('toast').classList.add('hidden');
}

function uploadFile(event) {
    event.preventDefault();
    
    const uploadBtn = document.getElementById('uploadFileBtn');
    const uploadText = document.getElementById('uploadFileText');
    const cancelBtn = document.getElementById('cancelFileBtn');
    
    // Disable button and show loading
    uploadBtn.disabled = true;
    cancelBtn.disabled = true;
    uploadBtn.classList.add('opacity-75', 'cursor-not-allowed');
    uploadText.innerHTML = '<i class="ph ph-spinner ph-spin mr-2"></i>Uploading...';
    
    const formData = new FormData(event.target);
    if (currentFolderId) formData.append('folder_id', currentFolderId);

    fetch('{{ route('edushare.store') }}', {
        method: 'POST',
        headers: { 'X-CSRF-TOKEN': '{{ csrf_token() }}' },
        body: formData
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            hideModal('upload');
            showToast(data.message, 'success');
            setTimeout(() => location.reload(), 1000);
        } else {
            // Re-enable button on error
            uploadBtn.disabled = false;
            cancelBtn.disabled = false;
            uploadBtn.classList.remove('opacity-75', 'cursor-not-allowed');
            uploadText.innerHTML = 'Upload';
            hideModal('upload');
            showToast(data.message || 'Failed to upload file', 'error');
        }
    })
    .catch(() => {
        // Re-enable button on error
        uploadBtn.disabled = false;
        cancelBtn.disabled = false;
        uploadBtn.classList.remove('opacity-75', 'cursor-not-allowed');
        uploadText.innerHTML = 'Upload';
        hideModal('upload');
        showToast('Failed to upload file', 'error');
    });
}

function createFolder(event) {
    event.preventDefault();
    
    const createBtn = document.getElementById('createFolderBtn');
    const createText = document.getElementById('createFolderText');
    const cancelBtn = document.getElementById('cancelFolderBtn');
    
    // Disable button and show loading
    createBtn.disabled = true;
    cancelBtn.disabled = true;
    createBtn.classList.add('opacity-75', 'cursor-not-allowed');
    createText.innerHTML = '<i class="ph ph-spinner ph-spin mr-2"></i>Creating...';
    
    const formData = new FormData();
    formData.append('name', document.getElementById('folderName').value);
    formData.append('description', document.getElementById('folderDescription').value);
    if (currentFolderId) formData.append('parent_id', currentFolderId);

    fetch('{{ route('edushare.folder.create') }}', {
        method: 'POST',
        headers: { 'X-CSRF-TOKEN': '{{ csrf_token() }}' },
        body: formData
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            hideModal('upload');
            showToast(data.message, 'success');
            setTimeout(() => location.reload(), 1000);
        } else {
            // Re-enable button on error
            createBtn.disabled = false;
            cancelBtn.disabled = false;
            createBtn.classList.remove('opacity-75', 'cursor-not-allowed');
            createText.innerHTML = 'Create Folder';
            hideModal('upload');
            showToast(data.message || 'Failed to create folder', 'error');
        }
    })
    .catch(() => {
        // Re-enable button on error
        createBtn.disabled = false;
        cancelBtn.disabled = false;
        createBtn.classList.remove('opacity-75', 'cursor-not-allowed');
        createText.innerHTML = 'Create Folder';
        hideModal('upload');
        showToast('Failed to create folder', 'error');
    });
}

function deleteItem(id) {
    fetch(`/edushare/item/${id}`, {
        method: 'DELETE',
        headers: { 'X-CSRF-TOKEN': '{{ csrf_token() }}' }
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            showToast(data.message, 'success');
            setTimeout(() => location.reload(), 1000);
        }
    })
    .catch(() => showToast('Failed to delete file', 'error'));
}

function deleteFolder(id) {
    fetch(`/edushare/folder/${id}`, {
        method: 'DELETE',
        headers: { 'X-CSRF-TOKEN': '{{ csrf_token() }}' }
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            showToast(data.message, 'success');
            setTimeout(() => location.reload(), 1000);
        }
    })
    .catch(() => showToast('Failed to delete folder', 'error'));
}
</script>
@endsection
