                    </ol>
                </div>

                <!-- Submit Button -->
                <button type="submit" id="gcashSubmitBtn" class="w-full bg-gradient-to-r from-green-500 to-green-600 text-white font-bold py-3 px-4 rounded-lg hover:shadow-lg transition-all duration-300 flex items-center justify-center gap-2">
                    <i class="ph ph-check-circle"></i>
                    <span>Proceed to Payment</span>
                </button>
            </form>

            <!-- Processing Message -->
            <div id="gcashProcessing" class="hidden text-center">
                <div class="mb-4">
                    <div class="inline-flex items-center justify-center w-16 h-16 bg-blue-100 rounded-full mb-4">
                        <i class="ph ph-spinner text-blue-600 text-4xl animate-spin"></i>
                    </div>
                </div>
                <h3 class="text-xl font-bold text-gray-900 mb-2">Processing Payment...</h3>
                <p class="text-gray-600 mb-6">Please wait while we submit your payment.</p>
            </div>

            <!-- Success Message -->
            <div id="gcashSuccess" class="hidden text-center">
                <div class="mb-4">
                    <div class="inline-flex items-center justify-center w-16 h-16 bg-green-100 rounded-full mb-4">
                        <i class="ph ph-check-circle text-green-600 text-4xl"></i>
                    </div>
                </div>
                <h3 class="text-xl font-bold text-gray-900 mb-2">Payment Initiated!</h3>
                <p class="text-gray-600 mb-6">Your payment has been submitted and is now pending verification by SOCCS officers.</p>
                <button onclick="handlePaymentDone()" class="w-full bg-purple-600 text-white font-bold py-3 px-4 rounded-lg hover:bg-purple-700 transition">
                    <i class="ph ph-check mr-2"></i>Done
                </button>
            </div>
        </div>
    </div>
</div>

<script>
function openGcashModal(amount, title, announcementId, gcashNumber) {
    const modal = document.getElementById('gcashModal');
    const form = document.getElementById('gcashPaymentForm');
    const successDiv = document.getElementById('gcashSuccess');
    const processingDiv = document.getElementById('gcashProcessing');

    modal.classList.remove('hidden');
    document.getElementById('gcash_amount').value = amount;
    document.getElementById('gcash_title').value = title;
    document.getElementById('gcash_announcement_id').value = announcementId;
    document.getElementById('gcash_number').value = gcashNumber || '09XX-XXX-XXXX';
    document.getElementById('displayAmount').textContent = '₱' + parseFloat(amount).toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});
    document.getElementById('displayGcashNumber').textContent = gcashNumber || '09XX-XXX-XXXX';
    successDiv.classList.add('hidden');
    processingDiv.classList.add('hidden');
    form.classList.remove('hidden');
}

function closeGcashModal() {
    document.getElementById('gcashModal').classList.add('hidden');
    document.getElementById('gcashPaymentForm').reset();
    document.getElementById('gcashSuccess').classList.add('hidden');
    document.getElementById('gcashProcessing').classList.add('hidden');
}

function openHistoryModal() {
    document.getElementById('historyModal').classList.remove('hidden');
}

function closeHistoryModal() {
    document.getElementById('historyModal').classList.add('hidden');
}

function handlePaymentDone() {
    // Get payment details from session storage (set during redirect)
    const paymentData = sessionStorage.getItem('pendingPaymentData');

    if (!paymentData) {
        alert('Payment data not found. Please try again.');
        closeGcashModal();
        return;
    }

    const data = JSON.parse(paymentData);
    const csrfToken = document.getElementById('csrf_token').value;

    // Submit payment to mark as completed
    fetch(`/payments/${data.announcement_id}/complete`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'X-CSRF-TOKEN': csrfToken,
            'Accept': 'application/json'
        },
        body: JSON.stringify({
            amount: parseFloat(data.amount),
            title: data.title
        })
    })
    .then(response => response.json())
    .then(result => {
        if (result.success) {
            // Clear pending payment data
            sessionStorage.removeItem('pendingPaymentData');
            // Store success message for toast after reload
            sessionStorage.setItem('paymentSuccess', result.message || 'Payment submitted successfully!');
            closeGcashModal();
            location.reload();
        } else {
            throw new Error(result.message || 'Payment failed');
        }
    })
    .catch(error => {
        alert('Error completing payment: ' + error.message);
        closeGcashModal();
    });
}

document.addEventListener('DOMContentLoaded', function() {
    // GCash Payment Button Listeners
    document.querySelectorAll('.gcash-pay-btn').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            const announcementId = this.dataset.id;
            const gcashNumber = this.dataset.gcash || '09XX-XXX-XXXX';
            openGcashModal(this.dataset.amount, this.dataset.title, announcementId, gcashNumber);
        });
    });

    // GCash Form Submit Handler
    const gcashForm = document.getElementById('gcashPaymentForm');
    if (gcashForm) {
        gcashForm.addEventListener('submit', function(e) {
            e.preventDefault();

            const amount = document.getElementById('gcash_amount').value;
            const title = document.getElementById('gcash_title').value;
            const announcementId = document.getElementById('gcash_announcement_id').value;

            if (!amount || !title || !announcementId) {
                alert('Please fill in all required fields');
                return;
            }

            // Show processing message
            document.getElementById('gcashPaymentForm').classList.add('hidden');
            document.getElementById('gcashProcessing').classList.remove('hidden');

            // Create checkout session via backend
            const csrfToken = document.getElementById('csrf_token').value;

            fetch('{{ route("payments.create-checkout") }}', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-TOKEN': csrfToken,
                    'Accept': 'application/json'
                },
                body: JSON.stringify({
                    amount: parseFloat(amount),
                    title: title,
                    announcement_id: announcementId
                })
            })
            .then(response => {
                if (!response.ok) {
                    return response.json().then(data => {
                        throw new Error(data.error || 'Payment processing failed');
                    });
                }
                return response.json();
            })
            .then(data => {
                if (data.checkout_url) {
                    // Redirect to PayMongo checkout (or mock success page)
                    window.location.href = data.checkout_url;
                } else {
                    throw new Error(data.error || 'No checkout URL received');
                }
            })
            .catch(error => {
                document.getElementById('gcashProcessing').classList.add('hidden');
                document.getElementById('gcashPaymentForm').classList.remove('hidden');
                alert('Error: ' + error.message);
            });
        });
    }

    // Check if returning from PayMongo payment - open modal immediately
    @if(session('payment_success'))
        // Store payment data in session storage for Done button
        const paymentData = {
            announcement_id: '{{ session("payment_data")["announcement_id"] ?? "" }}',
            amount: '{{ session("payment_data")["amount"] ?? "" }}',
            title: '{{ session("payment_data")["title"] ?? "" }}',
            category: '{{ session("payment_data")["category"] ?? "" }}'
        };

        sessionStorage.setItem('pendingPaymentData', JSON.stringify(paymentData));

        // Force modal to show with a slight delay to ensure DOM is ready
        setTimeout(function() {
            const gcashModal = document.getElementById('gcashModal');
            const gcashForm = document.getElementById('gcashPaymentForm');
            const gcashProcessing = document.getElementById('gcashProcessing');
            const gcashSuccess = document.getElementById('gcashSuccess');

            console.log('Modal elements found:', {
                modal: !!gcashModal,
                form: !!gcashForm,
                processing: !!gcashProcessing,
                success: !!gcashSuccess
            });

            if (gcashModal && gcashForm && gcashProcessing && gcashSuccess) {
                console.log('Opening modal...');

                // Force display with inline style and remove hidden class
                gcashModal.style.display = 'flex';
                gcashModal.classList.remove('hidden');

                gcashForm.style.display = 'none';
                gcashForm.classList.add('hidden');

                gcashProcessing.style.display = 'none';
                gcashProcessing.classList.add('hidden');

                gcashSuccess.style.display = 'block';
                gcashSuccess.classList.remove('hidden');

                console.log('Modal opened! Styles:', {
                    modalDisplay: gcashModal.style.display,
                    formDisplay: gcashForm.style.display,
                    processingDisplay: gcashProcessing.style.display,
                    successDisplay: gcashSuccess.style.display
                });
            } else {
                console.error('Some modal elements not found!');
            }
        }, 100);
    @endif

    // Check for payment completion success message
    const paymentSuccessMsg = sessionStorage.getItem('paymentSuccess');
    if (paymentSuccessMsg) {
        sessionStorage.removeItem('paymentSuccess');
        // Create and show success toast
        const toast = document.createElement('div');
        toast.setAttribute('x-data', '{ show: true }');
        toast.setAttribute('x-show', 'show');
        toast.setAttribute('x-init', 'setTimeout(() => show = false, 4000)');
        toast.className = 'fixed top-6 right-6 z-50 bg-white border-l-4 border-green-500 rounded-lg shadow-xl px-6 py-4 flex items-center space-x-3 max-w-md';
        toast.innerHTML = `
            <div class="flex-shrink-0">
                <div class="h-10 w-10 rounded-full bg-green-100 flex items-center justify-center">
                    <i class="ph ph-check-circle text-xl text-green-600"></i>
                </div>
            </div>
            <div class="flex-1">
                <p class="text-sm font-semibold text-gray-900">Success!</p>
                <p class="text-sm text-gray-600">${paymentSuccessMsg}</p>
            </div>
            <button onclick="this.parentElement.remove()" class="flex-shrink-0 text-gray-400 hover:text-gray-600 transition">
                <i class="ph ph-x text-lg"></i>
            </button>
        `;
        document.body.appendChild(toast);
        setTimeout(() => toast.remove(), 4500);
    }

    // Close modals when clicking outside
    window.addEventListener('click', function(event) {
        const gcashModal = document.getElementById('gcashModal');
        const historyModal = document.getElementById('historyModal');

        if (event.target === gcashModal) {
            closeGcashModal();
        }
        if (event.target === historyModal) {
            closeHistoryModal();
        }
    });
});
</script>

@endsection
