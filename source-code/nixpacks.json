{
  "phases": {
    "setup": {
      "aptPkgs": [
        "tesseract-ocr",
        "tesseract-ocr-eng", 
        "ghostscript",
        "imagemagick",
        "libpng-dev",
        "libjpeg-dev",
        "libmagickwand-dev"
      ]
    },
    "install": {
      "cmds": [
        "composer install --no-dev --optimize-autoloader --ignore-platform-reqs"
      ]
    },
    "build": {
      "cmds": [
        "mkdir -p storage/framework/{sessions,views,cache,testing} storage/logs bootstrap/cache storage/app/private/temp",
        "chmod -R 777 storage bootstrap/cache"
      ]
    }
  },
  "start": {
    "cmd": "php artisan migrate --force || true; php artisan queue:work redis --queue=document-ai,emails,default --tries=3 --timeout=300 & php artisan schedule:work & php artisan serve --host=0.0.0.0 --port=$PORT"
  }
}
