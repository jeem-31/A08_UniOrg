{
    "name": "soccsync/soccsync",
    "type": "project",
    "description": "SOCCSync - Student Organization Management System for CCS LSPU",
    "keywords": ["laravel", "framework", "student", "management"],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "barryvdh/laravel-dompdf": "^3.1",
        "dompdf/dompdf": "^3.1",
        "google/cloud-language": "^1.2",
        "google/cloud-vision": "^2.2",
        "laravel/framework": "^11.0",
        "laravel/reverb": "^1.10",
        "laravel/tinker": "^2.9",
        "league/flysystem-aws-s3-v3": "3.0",
        "livewire/livewire": "*",
        "phpoffice/phpspreadsheet": "^2.0",
        "predis/predis": "^3.5",
        "pusher/pusher-php-server": "^7.2",
        "resend/resend-php": "*",
        "smalot/pdfparser": "^2.12",
        "spatie/pdf-to-image": "^3.2",
        "thiagoalessio/tesseract_ocr": "^2.13"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.2",
        "fakerphp/faker": "^1.23",
        "giorgiosironi/eris": "1.1.0",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
